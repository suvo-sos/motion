# Local dev: in-process Postgres. No server, no network round trips, and dev
# startup migrations run against it instead of production.
# DATABASE_URL=pglite:./data/pglite

# Hosted Postgres for deployed builds (Supabase transaction pooler or Neon).
# Use the transaction pooler (port 6543) for runtime traffic. Session mode
# (5432) is capped at the project's pool_size (15 clients) and fails under
# concurrency with "(EMAXCONNSESSION) max clients reached in session mode".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Netlify maps this to DATABASE_URL automatically.
# NETLIFY_DATABASE_URL=

# Session pooler / direct connection, used only by migrations and DDL.
# Migrations prefer this over DATABASE_URL, so set it in the DEPLOY environment
# only — setting it next to a local `DATABASE_URL=pglite:...` sends dev startup
# migrations to production.
# DATABASE_URL_UNPOOLED=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Max connections per pool (hosted Postgres only). Local Node processes default
# to 20, which alone exceeds Supabase's 15-client session-pooler ceiling. Keep
# the sum of all pools below the database/pooler limit.
# AGENT_NATIVE_DB_POOL_MAX=8

# Auth is enabled by default. Set AUTH_DISABLED=true only for local demos.
# AUTH_DISABLED=true

# Optional while auth is disabled. Use a stable random value if enabled.
# BETTER_AUTH_SECRET=<openssl rand -hex 32>

# Optional: comma-separated trusted origins for auth.
# BETTER_AUTH_TRUSTED_ORIGINS=https://your-app.vercel.app,https://*.vercel.app

# Builder.io AI credentials (optional: pre-configures Builder.io for all visitors without OAuth popup)
# BUILDER_PRIVATE_KEY=bpk-...
# BUILDER_PUBLIC_KEY=...

# Custom health check message.
PING_MESSAGE=pong
